<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
body{width:100vw;height:100vh;background:#000;color:#00f0ff;font-family:'Share Tech Mono',monospace;display:flex;justify-content:center;align-items:center}
.container{display:flex;flex-direction:column;width:95vw;max-width:480px;height:95vh;padding:12px}
.logo{font-family:'Orbitron',sans-serif;font-size:28px;font-weight:900;color:#00f0ff;letter-spacing:8px;text-align:center;animation:pulse 3s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.65}}
.subtitle{font-size:8px;color:#00f0ff44;letter-spacing:2px;text-align:center;margin-bottom:8px}
.status{text-align:center;font-size:10px;color:#00f0ff66;margin-bottom:6px;min-height:16px}
.chat-box{flex:1;background:#000;border:1px solid #00f0ff22;border-radius:6px;overflow-y:auto;padding:10px;margin:6px 0}
.message{margin-bottom:10px}
.msg-label{font-size:8px;letter-spacing:2px;margin-bottom:3px}
.msg-label.jarvis{color:#00f0ff66}
.msg-label.user{color:#ff6b3566;text-align:right}
.msg-text{font-size:13px;line-height:1.5;padding:8px 12px;border-radius:5px;max-width:90%}
.msg-text.jarvis{background:#00f0ff0d;border-left:2px solid #00f0ff55;color:#00f0ffcc}
.msg-text.user{background:#ff6b350d;border-right:2px solid #ff6b3555;color:#ff6b35cc;margin-left:auto;text-align:right}
.typing{display:flex;gap:4px;padding:8px 12px;background:#00f0ff0d;border-radius:5px;width:fit-content}
.typing span{width:5px;height:5px;background:#00f0ff66;border-radius:50%;animation:bounce 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}
.typing span:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.input-row{display:flex;gap:8px;margin-top:8px;align-items:center}
#userInput{flex:1;background:#00f0ff08;border:1px solid #00f0ff33;border-radius:4px;padding:12px;color:#00f0ff;font-family:'Share Tech Mono',monospace;font-size:14px;outline:none}
#userInput::placeholder{color:#00f0ff33}
.send-btn{background:transparent;border:1px solid #00f0ff55;color:#00f0ff;font-size:11px;padding:12px 14px;border-radius:4px;cursor:pointer;white-space:nowrap}
.mic-btn{background:transparent;border:2px solid #ff6b3566;color:#ff6b35;font-size:22px;width:50px;height:50px;border-radius:50%;cursor:pointer;flex-shrink:0}
.mic-btn.on{background:#ff6b3522;border-color:#ff6b35;animation:micpulse 1.5s infinite}
@keyframes micpulse{0%,100%{box-shadow:0 0 0 0 #ff6b3544}50%{box-shadow:0 0 0 10px #ff6b3500}}
</style>
</head>
<body>
<div class="container">
  <div class="logo">JARVIS</div>
  <div class="subtitle">JUST A RATHER VERY INTELLIGENT SYSTEM</div>
  <div class="status" id="status">Hazır efendim</div>
  <div class="chat-box" id="chatBox"></div>
  <div class="input-row">
    <button class="mic-btn" id="micBtn">🎤</button>
    <input type="text" id="userInput" placeholder="Yazın veya konuşun..." autocomplete="off"/>
    <button class="send-btn" id="sendBtn">GÖNDER</button>
  </div>
</div>
<script>
const chatBox=document.getElementById("chatBox");
const userInput=document.getElementById("userInput");
const micBtn=document.getElementById("micBtn");
const status=document.getElementById("status");
const apiKey="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";
const SYSTEM="Sen JARVIS adli gelismis bir yapay zeka asistansin. Her zaman efendim diye hitap et. Kullanici Turkce konusursa Turkce, Ingilizce konusursa Ingilizce cevap ver. Kisa ve zekice cevaplar ver, maksimum 3 cumle.";
let conversationHistory=[];
let isProcessing=false;
let micOn=false;
let recognition=null;

document.getElementById("sendBtn").addEventListener("click",sendMessage);
userInput.addEventListener("keydown",function(e){if(e.key==="Enter")sendMessage();});
micBtn.addEventListener("click",toggleMic);

function setStatus(text){status.textContent=text;}

function addMessage(text,sender){
  var div=document.createElement("div");
  div.className="message";
  var label=document.createElement("div");
  label.className="msg-label "+sender;
  label.textContent=sender==="jarvis"?"◈ JARVIS":"▸ SİZ";
  var msg=document.createElement("div");
  msg.className="msg-text "+sender;
  msg.textContent=text;
  div.appendChild(label);
  div.appendChild(msg);
  chatBox.appendChild(div);
  chatBox.scrollTop=chatBox.scrollHeight;
}

function showTyping(){
  removeTyping();
  var div=document.createElement("div");
  div.className="message";
  div.id="typingIndicator";
  var label=document.createElement("div");
  label.className="msg-label jarvis";
  label.textContent="◈ JARVIS";
  var t=document.createElement("div");
  t.className="typing";
  t.innerHTML="<span></span><span></span><span></span>";
  div.appendChild(label);
  div.appendChild(t);
  chatBox.appendChild(div);
  chatBox.scrollTop=chatBox.scrollHeight;
}

function removeTyping(){
  var t=document.getElementById("typingIndicator");
  if(t)t.remove();
}

function speak(text){
  if(!window.speechSynthesis)return;
  speechSynthesis.cancel();
  var u=new SpeechSynthesisUtterance(text);
  u.lang="tr-TR";
  u.rate=0.9;
  u.pitch=0.85;
  u.onend=function(){
    if(micOn&&!isProcessing){
      setStatus("Dinleniyor...");
      startListening();
    }
  };
  speechSynthesis.speak(u);
}

async function callAPI(text){
  isProcessing=true;
  conversationHistory.push({role:"user",content:text});
  showTyping();
  setStatus("Düşünüyor...");
  var now=new Date();
  try{
    var r=await fetch("https://api.groq.com/openai/v1/chat/completions",{
      method:"POST",
      headers:{"Content-Type":"application/json","Authorization":"Bearer "+apiKey},
      body:JSON.stringify({
        model:"llama-3.3-70b-versatile",
        max_tokens:300,
        messages:[{role:"system",content:SYSTEM+" Saat:"+now.toLocaleTimeString("tr-TR")}].concat(conversationHistory)
      })
    });
    var data=await r.json();
    removeTyping();
    if(data.choices&&data.choices[0]){
      var reply=data.choices[0].message.content;
      conversationHistory.push({role:"assistant",content:reply});
      addMessage(reply,"jarvis");
      setStatus("Konuşuyor...");
      isProcessing=false;
      speak(reply);
    }else{
      addMessage("Hata olustu efendim.","jarvis");
      isProcessing=false;
      if(micOn)startListening();
    }
  }catch(err){
    removeTyping();
    addMessage("Baglanti hatasi efendim.","jarvis");
    isProcessing=false;
    if(micOn)startListening();
  }
}

async function sendMessage(){
  var text=userInput.value.trim();
  if(!text||isProcessing)return;
  userInput.value="";
  addMessage(text,"user");
  await callAPI(text);
}

function startListening(){
  if(!micOn||isProcessing)return;
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){
    setStatus("Mikrofon desteklenmiyor");
    return;
  }
  try{
    recognition=new SR();
    recognition.lang="tr-TR";
    recognition.continuous=false;
    recognition.interimResults=false;
    recognition.onstart=function(){
      setStatus("🔴 Dinleniyor...");
    };
    recognition.onresult=function(e){
      var text=e.results[0][0].transcript;
      if(text&&!isProcessing){
        addMessage(text,"user");
        callAPI(text);
      }
    };
    recognition.onend=function(){
      if(micOn&&!isProcessing){
        setTimeout(startListening,300);
      }
    };
    recognition.onerror=function(e){
      if(e.error==="not-allowed"){
        setStatus("Mikrofon izni verilmedi!");
        micOn=false;
        micBtn.className="mic-btn";
        micBtn.textContent="🎤";
      }else if(micOn&&!isProcessing){
        setTimeout(startListening,500);
      }
    };
    recognition.start();
  }catch(e){
    if(micOn&&!isProcessing)setTimeout(startListening,500);
  }
}

function toggleMic(){
  if(micOn){
    micOn=false;
    if(recognition)try{recognition.stop();}catch(e){}
    recognition=null;
    micBtn.textContent="🎤";
    micBtn.className="mic-btn";
    setStatus("Mikrofon kapatıldı");
    addMessage("Mikrofon kapatildi efendim.","jarvis");
  }else{
    navigator.mediaDevices.getUserMedia({audio:true}).then(function(){
      micOn=true;
      micBtn.textContent="🔴";
      micBtn.className="mic-btn on";
      setStatus("Dinleniyor...");
      addMessage("Mikrofon acildi efendim! Konusabilirsiniz.","jarvis");
      startListening();
    }).catch(function(err){
      addMessage("Mikrofon izni gerekli efendim. Tarayici ayarlarindan izin verin.","jarvis");
      setStatus("Mikrofon izni yok!");
    });
  }
}

window.onload=function(){
  if(window.speechSynthesis){
    speechSynthesis.getVoices();
    setTimeout(function(){speechSynthesis.getVoices();},500);
  }
  var now=new Date();
  var g="Hos geldiniz efendim. "+now.toLocaleTimeString("tr-TR")+" itibaриyla JARVIS aktif. Mikrofon icin 🎤 butonuna basin!";
  addMessage(g,"jarvis");
  conversationHistory.push({role:"assistant",content:g});
  setStatus("Hazır efendim");
};
</script>
</body>
</html>
